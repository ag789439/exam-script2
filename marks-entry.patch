-        '{% extends "base.html" %}\n{% block title %}Marks entry{% endblock %}\n{% block content %}\n<header class="page-head">\n  <div><h1>Marks entry</h1><p>Pick an exam and a subject, then fill one row per student</p></div>\n</header>\n\n<section class="card">\n  <form class="form-grid" method="get">\n    <label>Exam\n      <select name="exam_id" onchange="this.form.submit()">\n        <option value="">— choose —</option>\n        {% for e in exams %}\n          <option value="{{ e.id }}" {{ \'selected\' if exam_id == e.id|string }}>{{ exam_label(e) }}</option>\n        {% endfor %}\n      </select>\n    </label>\n    <label>Subject\n      <select name="subject_id" onchange="this.form.submit()">\n        <option value="">— choose —</option>\n        {% for s in subjects %}\n          <option value="{{ s.id }}" {{ \'selected\' if subject_id == s.id|string }}>{{ s.subject_name }} ({{ s.subject_code }})</option>\n        {% endfor %}\n      </select>\n    </label>\n    <noscript><div class="form-actions"><button class="btn ghost" type="submit">Load sheet</button></div></noscript>\n  </form>\n</section>\n\n{% if info %}<p class="info">{{ info }}</p>{% endif %}\n\n{% if sheet %}\n<section class="card">\n  <form method="post" id="marks-form"\n        data-max="{{ ctx.max_marks }}" data-pass="{{ ctx.pass_marks }}">\n    <input type="hidden" name="exam_id" value="{{ exam_id }}">\n    <input type="hidden" name="subject_id" value="{{ subject_id }}">\n    <div class="table-wrap">\n      <table class="grid" id="marks-table">\n        <thead><tr><th>Roll</th><th>Name</th><th>Status</th>\n                   <th class="num">Marks (max {{ fmt_num(ctx.max_marks) }})</th>\n                   <th>Result</th><th>Remarks</th></tr></thead>\n        <tbody>\n        {% for row in sheet %}\n          <tr data-status="{{ row.status }}">\n            <td>{{ row.student.roll_no }}</td>\n            <td>{{ row.student.name }}</td>\n            <td>\n              <select class="status-select" name="status_{{ row.student.id }}">\n                <option value="ENTERED" {{ \'selected\' if row.status == \'ENTERED\' }}>Entered</option>\n                <option value="ABSENT"  {{ \'selected\' if row.status == \'ABSENT\' }}>Absent (AB)</option>\n                <option value="EXEMPT"  {{ \'selected\' if row.status == \'EXEMPT\' }}>Exempt (EX)</option>\n              </select>\n            </td>\n            <td class="num">\n              <input class="mark-input" type="number" step="0.5" min="0"\n                     max="{{ ctx.max_marks }}" inputmode="decimal"\n                     name="marks_{{ row.student.id }}" value="{{ row.value }}">\n            </td>\n            <td class="result-cell">\n              {% if row.status == \'ABSENT\' %}<span class="tag bad">Absent</span>\n              {% elif row.status == \'EXEMPT\' %}<span class="tag info">Exempt</span>\n              {% elif row.value == \'\' %}<span class="muted">—</span>\n              {% elif row.value|float >= ctx.pass_marks %}<span class="tag ok">Pass</span>\n              {% else %}<span class="tag bad">Fail</span>{% endif %}\n            </td>\n            <td><input name="remarks_{{ row.student.id }}" value="{{ row.remarks }}"></td>\n          </tr>\n        {% endfor %}\n        </tbody>\n      </table>\n    </div>\n    <div class="form-actions">\n      <button class="btn primary" type="submit">Save all marks</button>\n    </div>\n  </form>\n</section>\n\n<section class="card">\n  <div class="card-head"><h2>Sheet summary</h2></div>\n  <p class="muted" id="summary-line">{{ info }}</p>\n</section>\n\n<script>\n(function () {\n  var form = document.getElementById(\'marks-form\');\n  if (!form) return;\n  var MAX = parseFloat(form.getAttribute(\'data-max\')) || 100;\n  var PASS = parseFloat(form.getAttribute(\'data-pass\')) || 33;\n  var rows = Array.prototype.slice.call(\n    document.querySelectorAll(\'#marks-table tbody tr\'));\n  var line = document.getElementById(\'summary-line\');\n\n  function tag(cls, text) {\n    var s = document.createElement(\'span\');\n    s.className = \'tag \' + cls;\n    s.textContent = text;\n    return s;\n  }\n\n  function paint(tr) {\n    var sel = tr.querySelector(\'.status-select\');\n    var inp = tr.querySelector(\'.mark-input\');\n    var cell = tr.querySelector(\'.result-cell\');\n    var status = sel.value;\n    tr.setAttribute(\'data-status\', status);\n\n    var off = status !== \'ENTERED\';\n    inp.disabled = off;\n    inp.className = off ? \'mark-input is-off\' : \'mark-input\';\n\n    while (cell.firstChild) cell.removeChild(cell.firstChild);\n    if (status === \'ABSENT\') { cell.appendChild(tag(\'bad\', \'Absent\')); return; }\n    if (status === \'EXEMPT\') { cell.appendChild(tag(\'info\', \'Exempt\')); return; }\n\n    var raw = inp.value.trim();\n    if (raw === \'\') {\n      var dash = document.createElement(\'span\');\n      dash.className = \'muted\';\n      dash.textContent = \'—\';\n      cell.appendChild(dash);\n      return;\n    }\n    var v = parseFloat(raw);\n    if (isNaN(v)) { cell.appendChild(tag(\'bad\', \'Not a number\')); return; }\n    if (v < 0 || v > MAX) { cell.appendChild(tag(\'bad\', \'Out of range\')); return; }\n    cell.appendChild(v >= PASS ? tag(\'ok\', \'Pass\') : tag(\'bad\', \'Fail\'));\n  }\n\n  function summary() {\n    var entered = 0, absent = 0, exempt = 0, pending = 0;\n    var sum = 0, hi = null, lo = null;\n    rows.forEach(function (tr) {\n      var status = tr.getAttribute(\'data-status\');\n      if (status === \'ABSENT\') { absent += 1; return; }\n      if (status === \'EXEMPT\') { exempt += 1; return; }\n      var raw = tr.querySelector(\'.mark-input\').value.trim();\n      var v = raw === \'\' ? NaN : parseFloat(raw);\n      if (isNaN(v)) { pending += 1; return; }\n      entered += 1;\n      sum += v;\n      if (hi === null || v > hi) hi = v;\n      if (lo === null || v < lo) lo = v;\n    });\n    var parts = [rows.length + \' students\', entered + \' entered\',\n                 absent + \' absent\', exempt + \' exempt\', pending + \' pending\'];\n    if (entered) {\n      parts.push(\'average \' + (sum / entered).toFixed(2));\n      parts.push(\'highest \' + hi);\n      parts.push(\'lowest \' + lo);\n    }\n    line.textContent = parts.join(\'  ·  \');\n  }\n\n  rows.forEach(function (tr) {\n    tr.querySelector(\'.status-select\').addEventListener(\'change\', function () {\n      paint(tr); summary();\n    });\n    tr.querySelector(\'.mark-input\').addEventListener(\'input\', function () {\n      paint(tr); summary();\n    });\n    paint(tr);\n  });\n  summary();\n})();\n</script>\n{% endif %}\n{% endblock %}\n',
