From 8e378282badb88e473e29a9f78c70cd712b9b005 Mon Sep 17 00:00:00 2001
From: Ayush Gupta <ag789439@gmail.com>
Date: Sat, 31 Oct 2026 19:13:19 +0000
Subject: [PATCH] Name the app Exam Script

APP_NAME is now Exam Script, matching the repository, and the login page
carries the same name. The marks constraint fix and the SITE_URL /
GOOGLE_SITE_VERIFICATION settings come along in this commit.
---
 app.py         | 23 +++++++++++++++++------
 auth_system.py | 25 ++++++++++++++++++++-----
 db.py          | 23 +++++++++++++++++++++++
 3 files changed, 60 insertions(+), 11 deletions(-)

diff --git a/app.py b/app.py
index d80405d..34d349b 100644
--- a/app.py
+++ b/app.py
@@ -54,7 +54,14 @@ from jinja2 import DictLoader
 
 import db as pgdb
 
-APP_NAME = os.environ.get("APP_NAME", "ExamSetu")
+APP_NAME = os.environ.get("APP_NAME", "Exam Script")
+# The public address of this app, once a custom domain is attached
+# (e.g. https://examsetu.in). Left empty, the request URL is used.
+SITE_URL = (os.environ.get("SITE_URL") or "").rstrip("/")
+# Search Console -> HTML tag verification. Paste the content value
+# into this variable and the meta tag appears in every page head.
+GOOGLE_SITE_VERIFICATION = (
+    os.environ.get("GOOGLE_SITE_VERIFICATION") or "").strip()
 SCHOOL_NAME = os.environ.get("SCHOOL_NAME", "Examination Management System")
 
 
